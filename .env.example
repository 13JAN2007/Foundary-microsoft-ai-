# Azure AI Foundry Suite - Environment Configuration Template
# Duplicate this file as .env and populate your credentials

# Google Gemini API Key (Required for live Gemini Responsible AI & NLP Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Microsoft Azure OpenAI Service (Optional - falls back to Gemini or local engine)
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Server Host and Port Configuration
HOST=0.0.0.0
PORT=8000
